{
  "name": "log-service",
  "version": "1.0.0",
  "private": true,
  "description": "A service that ingests high volumes of structured logs, stores them in PostgreSQL, and exposes query and time-bucketed aggregation APIs.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "kill": "lsof -ti :8080 | xargs kill -9 || true",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monazak/log-service.git"
  },
  "bugs": {
    "url": "https://github.com/monazak/log-service/issues"
  },
  "homepage": "https://github.com/monazak/log-service#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "pg": "^8.22.0"
  }
}
